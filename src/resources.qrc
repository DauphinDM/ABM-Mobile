<RCC>
  <qresource prefix="/">
    <file>Main.qml</file>
    <file>PlainLabel.qml</file>
    <file>MetricCard.qml</file>
    <file>VariantCard.qml</file>
    <file>GlassPanel.qml</file>
    <file>SectionPanel.qml</file>
    <file>StatusPill.qml</file>
    <file>HeroCluster.qml</file>
    <file>TelemetryRibbon.qml</file>
    <file>GMeter.qml</file>
    <file>NavDock.qml</file>
  </qresource>
  <qresource prefix="/qt/qml/MotorsportGlass">
    <file alias="qmldir">GlassStyle.qmldir</file>
    <file alias="Button.qml">GlassButton.qml</file>
    <file alias="TextField.qml">GlassTextField.qml</file>
    <file alias="TextArea.qml">GlassTextArea.qml</file>
    <file alias="Slider.qml">GlassSlider.qml</file>
    <file alias="FieldSurface.qml">GlassFieldSurface.qml</file>
    <file>FieldEditMenu.qml</file>
    <file alias="DialogButtonBox.qml">GlassDialogButtonBox.qml</file>
    <file alias="Dialog.qml">GlassDialog.qml</file>
    <file alias="ComboBox.qml">GlassComboBox.qml</file>
    <file alias="Menu.qml">GlassMenu.qml</file>
    <file alias="MenuItem.qml">GlassMenuItem.qml</file>
    <file alias="CheckBox.qml">GlassCheckBox.qml</file>
  </qresource>
</RCC>