#!/bin/sh
set -eu
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
PIN=b71f1470962019bd89534a2919f5925f93bc5779
DEST="$ROOT/vendor/android_openssl"
if [ ! -d "$DEST" ]; then
    mkdir -p "$DEST"
    git -C "$DEST" init
    git -C "$DEST" remote add origin https://github.com/KDAB/android_openssl.git
    git -C "$DEST" fetch --depth 1 origin "$PIN"
    git -C "$DEST" checkout --detach FETCH_HEAD
fi
test "$(git -C "$DEST" rev-parse HEAD)" = "$PIN"
mkdir -p "$ROOT/android/assets/notices"
cp "$ROOT/LICENSE" "$ROOT/android/assets/notices/ABM-Mobile-MIT.txt"
cp "$DEST/LICENSE" "$ROOT/android/assets/notices/KDAB-android-openssl.txt"
curl --fail --location https://raw.githubusercontent.com/openssl/openssl/openssl-3.6.0/LICENSE.txt -o "$ROOT/android/assets/notices/OpenSSL.txt"
for license in LGPL-3.0-only GPL-3.0-only; do
    curl --fail --location "https://raw.githubusercontent.com/qt/qtbase/v6.8.3/LICENSES/$license.txt" -o "$ROOT/android/assets/notices/$license.txt"
done
