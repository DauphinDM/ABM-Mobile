#!/usr/bin/env python3
"""Regenerate the committed opaque iPhone/iPad icons using ImageMagick."""
import json
from pathlib import Path
import subprocess

root = Path(__file__).resolve().parent.parent
catalog = root / 'ios/ABMMobile/Assets.xcassets'
icons = catalog / 'AppIcon.appiconset'
icons.mkdir(parents=True, exist_ok=True)
images = []
for idiom, sizes in [('iphone', [(20, [2, 3]), (29, [2, 3]), (40, [2, 3]), (60, [2, 3])]),
                     ('ipad', [(20, [1, 2]), (29, [1, 2]), (40, [1, 2]), (76, [1, 2]), (83.5, [2])]),
                     ('ios-marketing', [(1024, [1])])]:
    for size, scales in sizes:
        for scale in scales:
            pixels = int(size * scale)
            name = f'AppIcon-{idiom}-{size}@{scale}x.png'
            subprocess.run(['magick', '-background', '#FFD60A', str(root / 'ios/AppIcon.svg'),
                            '-resize', f'{pixels}x{pixels}', '-alpha', 'off', '-strip',
                            f'PNG24:{icons / name}'], check=True)
            images.append({'idiom': idiom, 'size': f'{size}x{size}', 'scale': f'{scale}x', 'filename': name})
info = {'author': 'xcode', 'version': 1}
(icons / 'Contents.json').write_text(json.dumps({'images': images, 'info': info}, indent=2) + '\n')
(catalog / 'Contents.json').write_text(json.dumps({'info': info}, indent=2) + '\n')
